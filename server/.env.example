PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=super_secret_job_portal_jwt_key_987654321
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Gmail SMTP Configuration for Real OTP Delivery
# ==============================================================================
# 1. Your Gmail address from which OTPs will be sent:
GMAIL_USER=your_email@gmail.com

# 2. 16-character Google App Password (NOT your normal Gmail login password):
# Generate yours in 30 seconds at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google account)
GMAIL_APP_PASSWORD=your_16_character_app_password

# Optional sender display name
FROM_NAME="Smart Job Portal Security"
