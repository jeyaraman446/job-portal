PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=super_secret_job_portal_jwt_key_987654321
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Transactional Email Configuration (Nodemailer / SMTP / Brevo / Gmail)
# If credentials are left blank, the app falls back to local simulation logging
# ==============================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_or_brevo_email@example.com
SMTP_PASS=your_smtp_password_or_brevo_key
SMTP_FROM=noreply@smartjobportal.com

# Brevo (Bravo) Specific Keys (Optional convenience)
BREVO_USER=your_brevo_account_email@example.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_master_smtp_key_here
BREVO_SENDER=noreply@smartjobportal.com
