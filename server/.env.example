PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=super_secret_job_portal_jwt_key_987654321
CLIENT_URL=http://localhost:5173

# ==============================================================================
# 🚀 Brevo (Bravo) SMTP Configuration (Recommended - Free 300 emails/day)
# Get your Brevo SMTP key in 1 minute: https://app.brevo.com/settings/keys/smtp
# ==============================================================================
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_account_email@example.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_master_smtp_key_here
BREVO_SENDER=your_verified_sender_email@example.com

# ==============================================================================
# Alternative: Direct Gmail SMTP Configuration
# 16-character App Password from: https://myaccount.google.com/apppasswords
# ==============================================================================
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Custom Sender Display Name
FROM_NAME="SmartMatch Talent Portal"
